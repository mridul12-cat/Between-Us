<style>
.root { flex-direction: column; width: 620px; padding: 26px; gap: 14px; background-color: #f5f3e9; border-radius: 28px; border-width: 2px; border-color: #b9cbc3; }
.row { flex-direction: row; align-items: center; gap: 10px; }
.column { flex-direction: column; gap: 8px; }
