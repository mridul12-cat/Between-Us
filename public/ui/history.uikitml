<style>
.root { flex-direction: column; width: 620px; padding: 26px; gap: 14px; background-color: #f8f3eb; border-radius: 28px; border-width: 2px; border-color: #b9cbc3; }
.row { flex-direction: row; align-items: center; gap: 10px; }
.column { flex-direction: column; gap: 8px; }
.eyebrow { font-size: 14px; font-weight: 700; color: #267367; letter-spacing: 1px; }
.title { font-size: 48px; font-weight: 700; color: #26394a; }
.body { font-size: 22px; color: #283e53; line-height: 1.35; }
.small { font-size: 16px; color: #53656b; line-height: 1.3; }
.button { padding: 13px; border-radius: 14px; background-color: #e6eae9; border-width: 1px; border-color: #b8cec4; justify-content: center; align-items: center; cursor: pointer; }
.button:hover { background-color: #c6ddd3; border-color: #367d70; }
.label { font-size: 20px; font-weight: 700; color: #274b48; }
.primary { background-color: #246d62; border-color: #246d62; }
.white { color: #ffffff; }
</style><div class="root" id="surface" style="width: 600px"><span id="history-mode" class="eyebrow">CONVERSATION NOTES | DEMO</span><span class="title" style="font-size: 30px">Caption history</span><div id="history-area" style="height: 320px; width: 548px"></div><span id="history-position" class="small">No captions</span><div class="row"><div id="older" class="button"><span class="label">Older</span></div><div id="newer" class="button"><span class="label">Newer</span></div><div id="clear-history" class="button"><span id="clear-history-label" class="label">Clear</span></div><div id="close-history" class="button"><span id="close-history-label" class="label">Close</span></div></div></div>